# Base URL used for metadata, sitemap, and canonical links
NEXT_PUBLIC_SITE_URL=https://upliftas.com

# --- Contact form: email delivery via EmailJS (https://www.emailjs.com) ---
# Public, safe to expose to the browser — these identify your EmailJS
# account/template, not a secret credential.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# --- Contact form: Telegram delivery ---
# Server-side only (no NEXT_PUBLIC_ prefix) — used by src/app/api/contact/route.js.
# 1. Message @BotFather on Telegram to create a bot and get its token.
# 2. Message your new bot once, then visit
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat_id.
TELEGRAM_BOT_TOKEN=8668313614:AAGI2WLyrt-ySAPxJWpNaYBy5XwGxjLgkqs
TELEGRAM_CHAT_ID=-1003897115433

# Optional: analytics id (e.g. Plausible, GA4, etc.)
# NEXT_PUBLIC_ANALYTICS_ID=

